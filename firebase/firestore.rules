rules_version = '2';

// Stock Tracker — Firestore security rules.
// Paste this into Firebase Console → Firestore Database → Rules, replace
// ALLOWED_EMAIL with your own Google account email, and click Publish.
//
// Every car document (and its embedded costs) can only be read or written by
// a signed-in user whose Google account email matches exactly. Nobody else —
// even someone with the app's public config values — can access the data.

service cloud.firestore {
  match /databases/{database}/documents {
    match /cars/{carId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'ALLOWED_EMAIL';
    }
  }
}
